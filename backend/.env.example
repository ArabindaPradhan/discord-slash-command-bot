NODE_ENV=
PORT=3001

# PostgreSQL — use a full connection URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session TTL in hours
SESSION_TTL_HOURS=24

# Discord Application settings — from Discord Developer Portal
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Discord OAuth2 — for "Add to Discord" flow
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/v1/auth/discord/callback

# For guild-specific (instant) command registration during development
DISCORD_GUILD_ID=

# Mirror channel webhook — store here server-side only, never expose to client
MIRROR_DISCORD_WEBHOOK_URL=

# AI provider — 'gemini' or 'groq' (only if AI stretch goal is enabled)
AI_PROVIDER=gemini
AI_API_KEY=

# Frontend URL — used for CORS
FRONTEND_URL=http://localhost:5173
